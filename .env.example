# =============================================================================
# GlowOS environment variables
# -----------------------------------------------------------------------------
# Copy to `.env.local` for local dev, and set the real values in the Vercel /
# Supabase dashboards for production. NEVER commit real values — `.env*` is
# gitignored. Rotate immediately if any secret leaks.
# =============================================================================

# --- Supabase (Project Settings -> API) -------------------------------------
# Safe to expose to the browser. The anon key is only safe because RLS is
# airtight — see supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# SERVER-ONLY. Bypasses RLS. Must never reach a client bundle. Used only in
# server routes for privileged writes (webhooks, audit log, data-deletion RPC).
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# --- Anthropic (Phase 2) — SERVER-ONLY --------------------------------------
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# --- Upstash Redis rate limiting --------------------------------------------
# If unset, rate limiting fails OPEN in development and logs a warning.
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_TOKEN"

# --- Razorpay (Phase 3) — keep secret + webhook secret SERVER-ONLY ----------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_XXXXXXXX"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# --- Sentry (Phase 4) -------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""

# --- App ---------------------------------------------------------------------
# Canonical site URL, used for OAuth redirect + email links + CORS.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Salt for hashing IPs in audit_log (SHA-256 + salt). SERVER-ONLY.
IP_HASH_SALT="change-me-to-a-long-random-string"

# --- AI model override (optional) -------------------------------------------
# Defaults to claude-opus-5. Set e.g. claude-sonnet-5 to trade quality for cost.
CLAUDE_MODEL="claude-opus-5"
